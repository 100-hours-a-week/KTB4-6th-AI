MEETY_ENVIRONMENT=local
MEETY_LOG_LEVEL=INFO
MEETY_SENTRY_DSN=
MEETY_MAX_RECORDING_CONNECTIONS=20
MEETY_BACKEND_BASE_URL=http://localhost:8080
MEETY_CHAT_MODEL=openai/gpt-6-luna
MEETY_CHAT_TIMEOUT_SECONDS=60
MEETY_SUMMARY_MODEL=openai/gpt-6-luna
MEETY_SUMMARY_TIMEOUT_SECONDS=120
MEETY_DIARIZATION_TIMEOUT_SECONDS=3600

SPEECHMATICS_API_KEY=
OPENROUTER_API_KEY=
# 백엔드 INTERNAL_API_KEY와 같은 값을 설정한다.
INTERNAL_API_KEY=
MODAL_TOKEN_ID=ak-
MODAL_TOKEN_SECRET=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meety
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
