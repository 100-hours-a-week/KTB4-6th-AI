# 가짜 공급자 부하테스트용 설정. uvicorn --env-file .env.loadtest.example로 넘긴다.
# .env로 복사하면 운영 Settings가 FAKE_ 항목을 미정의 값으로 거부한다.
# 서버는 meety_ai.fake_providers의 앱 팩토리로 띄운다. 운영(production)에서는 거부된다.
MEETY_ENVIRONMENT=local
MEETY_LOG_LEVEL=INFO

# 지연값은 2026-09-26 23분 회의 E2E 실측(experiments/diarization-e2e) 기준이다.
# STT: 세션 후반 확정 전사 지연 2.8~4.7초. 앞부분은 클라이언트 송출 드리프트로 오염돼 제외했다.
FAKE_STT_LATENCY_MS=3000
# 요약: 전사 352구간 요약 요청 약 15.5초.
FAKE_SUMMARY_LATENCY_MS=15500
# 화자 분리: warm 7.0초, 콜드 스타트 38.5초. 오디오 길이에 비례하므로 긴 회의는 늘려 잡는다.
FAKE_DIARIZATION_LATENCY_MS=7000

# 가짜 모드에서도 서비스 설정이 키를 요구하므로 더미 값을 넣는다.
SPEECHMATICS_API_KEY=dummy
OPENROUTER_API_KEY=dummy
